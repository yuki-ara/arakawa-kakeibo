# コピーして .env を作り、値を設定する（.env は絶対にコミットしない）
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# publishable key（sb_publishable_...）または legacy anon key。service_role / secret key は入れない
PUBLIC_SUPABASE_KEY=

# 本番（ラズパイ）のみ: ブラウザで開くURLと一致させる。フォーム送信(POST)のCSRFチェックに必要
# 例) tailscale serve で HTTPS 公開する場合: https://<ホスト名>.<tailnet名>.ts.net
# ORIGIN=
